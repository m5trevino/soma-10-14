[Unit]
Description=Publish PEA manifests every minute

[Timer]
# Run 20s after boot, then every 60s. Manifests are appended during a run, so a
# one-minute lag keeps the viewer current without hammering the disk.
OnBootSec=20s
OnUnitActiveSec=60s
AccuracySec=5s
Unit=pea-manifest-sync.service

[Install]
WantedBy=timers.target
